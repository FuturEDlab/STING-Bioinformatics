        selectedHoverSprite: {fileID: 21300000, guid: 55a244314a9f34017980666919bbd345, type: 3}
  majorQuestionSets:
  - majorName: Nursing
    majorQuestion:
      questionText: Taylor exhibited alert fatigue. How did the false alert in Scene
        1 contribute to the error in Scene 3?
      questionTextFieldHeight: 146
      questionAudioClip: {fileID: 8300000, guid: 0ab5a6a1d233440dd97593bd16a2d1c8, type: 3}
      ColoredAnswerSprites:
      - {fileID: 21300000, guid: 825fbaabec4e149e3a4178b647bebcbe, type: 3}
      - {fileID: 21300000, guid: fb990d74af735436c86ca29a9e07c021, type: 3}
      - {fileID: 21300000, guid: 75e3e428c1a9c4471b68261f01499b9f, type: 3}
      - {fileID: 21300000, guid: ac35d5ee7d5ad45b6ae1d5e4ad82add2, type: 3}
      explanationImageCorrect: {fileID: 21300000, guid: 55da10204ffc54671822d1581bc1e52c, type: 3}
      explanationImageIncorrect: {fileID: 21300000, guid: a4a796e3c6da947b7b3e47fbe84642a9, type: 3}
      explanationAudioCorrect: {fileID: 8300000, guid: d22e99a1ad35f4b8ead77d4b1de65c40, type: 3}
      explanationAudioIncorrect: {fileID: 8300000, guid: f83e431c4f75345e5939c80fd3d16907, type: 3}
      answers:
      - answerText: It increased Sarah's workload, making her rush
        answerImage: {fileID: 21300000, guid: 825fbaabec4e149e3a4178b647bebcbe, type: 3}
        isCorrect: 0
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: f2abc978aca234ffeb1aaa89b7b1a8d0, type: 3}
          hoverSprite: {fileID: 21300000, guid: 8ab82b164960049158667495a7f5c2ca, type: 3}
          selectedSprite: {fileID: 21300000, guid: e0eec74a3fe544c52b8963f39654221e, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: 60f934ecf230642efad845a4d74fc743, type: 3}
      - answerText: It delayed medication administration
        answerImage: {fileID: 21300000, guid: 644ee017e0c5145a0a511a75fc01ee9a, type: 3}
        isCorrect: 0
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: 644ee017e0c5145a0a511a75fc01ee9a, type: 3}
          hoverSprite: {fileID: 21300000, guid: fb0ee90e0e882479c9b8442c58254477, type: 3}
          selectedSprite: {fileID: 21300000, guid: 49b7496648f6141c7810baf3924ef66a, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: d1520470240124a81a432b7f8900eaa1, type: 3}
      - answerText: It changed the patient's allergy status
        answerImage: {fileID: 21300000, guid: 9475360a1fedd4181bce2786a1796127, type: 3}
        isCorrect: 0
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: 9475360a1fedd4181bce2786a1796127, type: 3}
          hoverSprite: {fileID: 21300000, guid: 51590d47b72b24b7e94bc952f7556e49, type: 3}
          selectedSprite: {fileID: 21300000, guid: 6a464de080c724d64b9721ea92627dfe, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: a27db4d7a803244e5a9274e310301518, type: 3}
      - answerText: It caused Sarah to distrust alerts, leading her to override a
          valid safety check
        answerImage: {fileID: 21300000, guid: f889345372c7a49b1b23b33537eda85f, type: 3}
        isCorrect: 1
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: f889345372c7a49b1b23b33537eda85f, type: 3}
          hoverSprite: {fileID: 21300000, guid: b8c15d1e31a244a2ea71851b49849644, type: 3}
          selectedSprite: {fileID: 21300000, guid: 1751d60a2fce14e48a2012608e91733a, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: 13e669d9d8cd4429cb51fc52967701f2, type: 3}
  - majorName: Health Informatics / Computing
    majorQuestion:
      questionText: The Amoxicillin error was caused by trusting unstructured free
        text. How should the EHR be redesigned to prevent a 5000 mg overdose entry?
      questionTextFieldHeight: 219
      questionAudioClip: {fileID: 8300000, guid: 8590b8e056ba245bc91cc1a9c6bd3bfd, type: 3}
      ColoredAnswerSprites:
      - {fileID: 21300000, guid: 859dd52b7df764ba880b4b816840e6a1, type: 3}
      - {fileID: 21300000, guid: 86389e46cbc2e46548dc5b6479df7b79, type: 3}
      - {fileID: 21300000, guid: 4529f5cc8a57f4b07b4c0b1e07d490ff, type: 3}
      - {fileID: 21300000, guid: 594aa7c7fadc642b3bb986a46aa1d519, type: 3}
      explanationImageCorrect: {fileID: 21300000, guid: dbd476513d3774f9fa83aef03c0437dd, type: 3}
      explanationImageIncorrect: {fileID: 21300000, guid: c7a923b58555240ef93fb28ee3c34ed2, type: 3}
      explanationAudioCorrect: {fileID: 8300000, guid: 15f6f7756ea504896be67617f7b262f5, type: 3}
      explanationAudioIncorrect: {fileID: 8300000, guid: 2f73ca4faa5024025a9190fc147f81d8, type: 3}
      answers:
      - answerText: Implement spellcheck on all nursing notes
        answerImage: {fileID: 21300000, guid: 810831501d0564bea803abf37b91b888, type: 3}
        isCorrect: 0
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: 810831501d0564bea803abf37b91b888, type: 3}
          hoverSprite: {fileID: 21300000, guid: 68913a003702c4fdfaeb918e79adce32, type: 3}
          selectedSprite: {fileID: 21300000, guid: 60ab92180c8c84cb39cb631ccc618b3b, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: 4402acb094b0646058419c11d052bfe7, type: 3}
      - answerText: Remove historical nurse notes to reduce clutter
        answerImage: {fileID: 21300000, guid: 0bc6be0c6d31e4ea1ad878edae9b07d5, type: 3}
        isCorrect: 0
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: 0bc6be0c6d31e4ea1ad878edae9b07d5, type: 3}
          hoverSprite: {fileID: 21300000, guid: 28ab5f243ddc447b083c8cc2be4c2fef, type: 3}
          selectedSprite: {fileID: 21300000, guid: fbfcb356eacbe4b17bb420a91ba12342, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: b22d36f6390274714ba3ff5d767a497b, type: 3}
      - answerText: Increase the number of namual override permissions for clinicians
        answerImage: {fileID: 21300000, guid: 8e823c26cebc54963a751f6b3fb66857, type: 3}
        isCorrect: 0
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: 8e823c26cebc54963a751f6b3fb66857, type: 3}
          hoverSprite: {fileID: 21300000, guid: d672369613f8548429b1f596dc6874bb, type: 3}
          selectedSprite: {fileID: 21300000, guid: 8caac160e0aee41ecbf95340120db3a9, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: 47d406e284139480496282bf3a8bffe2, type: 3}
      - answerText: Use structured data fields with dose-range validation and hard
          stops
        answerImage: {fileID: 21300000, guid: 663ad53f423984612a3955a8ba223d64, type: 3}
        isCorrect: 1
        buttonStateSprites:
          defaultSprite: {fileID: 21300000, guid: 663ad53f423984612a3955a8ba223d64, type: 3}
          hoverSprite: {fileID: 21300000, guid: ee98290c3ee6d4ab1bea5bfebaaf8802, type: 3}
          selectedSprite: {fileID: 21300000, guid: ed35f7a91c4ed4a858326776cae58149, type: 3}
          selectedHoverSprite: {fileID: 21300000, guid: f96994d68b8b64216bce92a03f3936da, type: 3}
