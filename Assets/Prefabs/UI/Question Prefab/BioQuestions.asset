    answers:
    - answerText: Patient is allergic
      answerImage: {fileID: 21300000, guid: 6209fa0fd4743437f8f5827bdc918efc, type: 3}
      isCorrect: 0
      buttonStateSprites:
        defaultSprite: {fileID: 21300000, guid: 6209fa0fd4743437f8f5827bdc918efc, type: 3}
        hoverSprite: {fileID: 21300000, guid: 5bde75f1d8f2042159692cf8b43ca174, type: 3}
