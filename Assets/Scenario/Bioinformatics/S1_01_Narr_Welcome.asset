  m_Script: {fileID: 11500000, guid: d5cf676fdee57a341b2938e596ad8bec, type: 3}
  m_Name: S1_01_Narr_Welcome
  m_EditorClassIdentifier: Assembly-CSharp::NarratorStepData
  speaker: Narrator
  phrases:
  - clip: {fileID: 8300000, guid: 8ec4897f5545d41a2bf0ba27186f978b, type: 3}
    caption: {fileID: 21300000, guid: ca8c7682bf1b64f63a03b88786b8510e, type: 3}
    captionText: Welcome to the "Designing Safe Clinical Decision
  - clip: {fileID: 8300000, guid: 670ea6feb4249450ab4cfca504043347, type: 3}
    caption: {fileID: 21300000, guid: 4afa372246a8e496592fbe724d29019b, type: 3}
    captionText: Support" VR experience. Clinical Decision Support, or CDS, refers
  - clip: {fileID: 8300000, guid: 6d4fc5eb0441a49ee976ef10a873348c, type: 3}
    caption: {fileID: 21300000, guid: 198c25722a1f14e08be8978565366491, type: 3}
    captionText: to software built into the Electronic Health Record that provides
  - clip: {fileID: 8300000, guid: 5b5afc05b049a4cc0b92bd856fe22383, type: 3}
    caption: {fileID: 21300000, guid: b81afa74a98b8489da41684fa1c6566e, type: 3}
    captionText: clinicians with patient-specific alerts, reminders, and
  - clip: {fileID: 8300000, guid: 67e92f2b82e33496c9ad5fa23e0d0392, type: 3}
    caption: {fileID: 21300000, guid: 46a9d0b0a56b945b6bda84ee35fabc79, type: 3}
    captionText: recommendations. When designed well, CDS helps prevent medication
  - clip: {fileID: 8300000, guid: f3288b8ae903b4d26b8d80b478a4be18, type: 3}
    caption: {fileID: 21300000, guid: 4048f8f17dc504e22989ce55da12fdbc, type: 3}
    captionText: errors and improves patient safety. When designed poorly, it can
  - clip: {fileID: 8300000, guid: 87ea2b5d180e54430a76ebbb8d79d7eb, type: 3}
    caption: {fileID: 21300000, guid: 2b3c5662cc15741f691cdcdc8fcb0025, type: 3}
    captionText: introduce new risks.
